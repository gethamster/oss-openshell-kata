# syntax=docker/dockerfile:1.7
# Turn an Ubuntu/Debian-based environment image into an admissible Kata guest:
# the native guest init, SSH entry as `sandbox` (uid 1000, home /sandbox), an
# in-guest Docker daemon and the static workspace helper from this source tree.
# Build from the repository root:
#   docker build -f runtime/Dockerfile.layer --build-arg BASE=<image@sha256:...> .
ARG BASE

FROM rust:1.98.1-alpine@sha256:7cc1c22d77d9432f7fe012a70e6d3e555af54c2a6832700ed7d553f1769ae89f AS helper
RUN apk add --no-cache build-base perl cmake
WORKDIR /src
COPY Cargo.toml Cargo.lock build.rs ./
COPY src ./src
COPY proto ./proto
COPY protocol ./protocol
# The musl target links statically, so the helper runs on any glibc base.
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/src/target,sharing=locked \
    cargo build --release --locked --bin kata-workspace \
    && install -D target/release/kata-workspace /out/kata-workspace

# Debian's docker.io package does not supply the Compose CLI plugin. Carry the
# same independently packaged plugin as normal sandboxes, without another daemon.
FROM alpine:3.23@sha256:ff7f0c727dd796aa36787bfcd9a64bf35a6ce72a73451b3359fde849b6703d63 AS compose
RUN apk add --no-cache docker-cli-compose

FROM ${BASE}
USER root
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      openssh-server docker.io curl ca-certificates iproute2 musl python3; \
    rm -rf /var/lib/apt/lists/*; \
    existing=$(getent passwd 1000 | cut -d: -f1 || true); \
    if [ -n "$existing" ] && [ "$existing" != sandbox ]; then \
      group=$(id -gn "$existing"); \
      usermod -l sandbox -d /sandbox "$existing"; \
      [ "$group" = sandbox ] || groupmod -n sandbox "$group"; \
    elif [ -z "$existing" ]; then \
      if getent group 1000 >/dev/null; then \
        groupmod -n sandbox "$(getent group 1000 | cut -d: -f1)"; \
      else \
        groupadd -g 1000 sandbox; \
      fi; \
      useradd -u 1000 -g 1000 -d /sandbox -s /bin/bash sandbox; \
    fi; \
    passwd -d sandbox; \
    mkdir -p /sandbox /run/guest-ssh /run/sshd; \
    chown 1000:1000 /sandbox; \
    test "$(id -u sandbox)" = 1000
COPY --from=helper /out/kata-workspace /usr/local/bin/kata-workspace
COPY --from=compose /usr/libexec/docker/cli-plugins/docker-compose /usr/libexec/docker/cli-plugins/docker-compose
COPY runtime/guest-init.sh /usr/local/sbin/openshell-kata-init
COPY runtime/sshd_config /etc/ssh/openshell-kata.conf
RUN chmod 755 /usr/local/sbin/openshell-kata-init /usr/local/bin/kata-workspace \
    && ln -s /usr/libexec/docker/cli-plugins/docker-compose /usr/local/bin/docker-compose \
    && test -x /usr/sbin/sshd && command -v dockerd && command -v curl \
    && docker compose version && docker-compose version
ENTRYPOINT ["/usr/local/sbin/openshell-kata-init"]
